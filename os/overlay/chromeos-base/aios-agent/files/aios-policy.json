{
  "rules": [
    {
      "id": "deny-privileged",
      "decision": "deny",
      "action": "*",
      "target": "*",
      "risk": "privileged",
      "reason": "The agent never runs with elevated privileges."
    },
    {
      "id": "deny-dev",
      "decision": "deny",
      "action": "*",
      "target": "/dev/*",
      "reason": "Raw devices are off limits."
    },
    {
      "id": "deny-shadow",
      "decision": "deny",
      "action": "*",
      "target": "/etc/shadow*",
      "reason": "Password hashes are off limits."
    },
    {
      "id": "deny-os-bin-write",
